---
---
<div class="cp-controls">
  <label for="cp-vztp">Prop model (vztp)</label>
  <select id="cp-vztp">
    <option value="3.6">3.6 — Vy just above Vmd</option>
    <option value="3.3" selected>3.3 — default, Vmd ≈ Vy</option>
    <option value="3.0">3.0 — Vy just below Vmd</option>
  </select>
</div>
<climb-performance id="climb-performance-demo" height="540px" vs="45" cruise-kts="145" vztp="3.3" show-help="false"></climb-performance>

<style>
  .cp-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    margin-bottom: 12px;
  }
  .cp-controls select {
    background: var(--sl-color-bg-inline-code, #313244);
    color: var(--sl-color-gray-1, #cdd6f4);
    border: 1px solid var(--sl-color-gray-5, #45475a);
    padding: 6px 12px;
    border-radius: 4px;
    cursor: pointer;
    font: inherit;
  }
</style>

<script>
  import '../../src/define'

  const select = document.getElementById('cp-vztp') as HTMLSelectElement
  const element = document.getElementById('climb-performance-demo')!
  select.addEventListener('change', () => element.setAttribute('vztp', select.value))
</script>
